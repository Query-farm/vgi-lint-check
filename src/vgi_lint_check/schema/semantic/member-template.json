{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://query.farm/schema/vgi/semantic/member-template.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_id", "template", "members"],
  "properties": {
    "template_id": {"$ref": "definitions.json#/$defs/semantic_id"},
    "template": {
      "$ref": "#/$defs/member_patch",
      "not": {"required": ["member_id"]}
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/member_patch"},
          {"required": ["member_id"]}
        ]
      }
    }
  },
  "$defs": {
    "member_patch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "member_id": {"$ref": "definitions.json#/$defs/semantic_id"},
        "kind": {"enum": ["identifier", "dimension", "time_dimension", "measure"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "data_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "output_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "hidden": {"type": "boolean"},
        "column": {"type": "string", "minLength": 1},
        "column_path": {"$ref": "member.json#/$defs/column_path"},
        "source_argument": {"type": "string", "minLength": 1},
        "expression": {"$ref": "expression.json"},
        "unit": {"type": "string", "minLength": 1},
        "unit_parameter": {"$ref": "member.json#/$defs/unit_parameter"},
        "timezone": {"type": "string", "minLength": 1},
        "granularities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["minute", "hour", "day", "week", "month", "quarter", "year"]}
        },
        "week_start": {"const": "monday"},
        "aggregation": {"enum": ["count_rows", "count", "count_distinct", "sum", "min", "max", "avg"]},
        "member": {"$ref": "definitions.json#/$defs/semantic_id"},
        "additivity": {"$ref": "definitions.json#/$defs/additivity"}
      }
    }
  }
}
