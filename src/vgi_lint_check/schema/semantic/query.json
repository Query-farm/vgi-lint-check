{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://query.farm/schema/vgi/semantic/query.json",
  "type":"object","additionalProperties":false,"properties":{
    "measures":{"type":"array","maxItems":50,"items":{"type":"object","additionalProperties":false,"required":["catalog_id","entity_id","member_id"],"properties":{"catalog_id":{"$ref":"definitions.json#/$defs/catalog_id"},"entity_id":{"$ref":"definitions.json#/$defs/semantic_id"},"member_id":{"$ref":"definitions.json#/$defs/semantic_id"},"alias":{"type":"string"}}}},
    "dimensions":{"type":"array","maxItems":50,"items":{"type":"object","additionalProperties":false,"required":["catalog_id","entity_id","member_id"],"properties":{"catalog_id":{"$ref":"definitions.json#/$defs/catalog_id"},"entity_id":{"$ref":"definitions.json#/$defs/semantic_id"},"member_id":{"$ref":"definitions.json#/$defs/semantic_id"},"relationship_path":{"type":"array","items":{"$ref":"definitions.json#/$defs/semantic_id"}},"granularity":{"enum":["minute","hour","day","week","month","quarter","year"]},"alias":{"type":"string"}}}},
    "filters":{"$ref":"#/$defs/filter"},"measure_filters":{"$ref":"#/$defs/filter"},
    "order":{"type":"array","maxItems":50,"items":{"type":"object","additionalProperties":false,"required":["member","direction"],"properties":{"member":{"type":"string","minLength":1},"direction":{"enum":["asc","desc"]}}}},
    "limit":{"type":"integer","minimum":1,"maximum":10000,"default":1000},"compile_only":{"type":"boolean","default":false},
    "root_entity":{"$ref":"definitions.json#/$defs/entity_ref"},
    "bindings":{"type":"object","additionalProperties":{"type":"string","minLength":1}},
    "parameters":{"type":"object","additionalProperties":true}
  },"anyOf":[{"required":["measures"]},{"required":["dimensions"]}],
  "$defs":{
    "filter_member":{"oneOf":[
      {"type":"string","minLength":1},
      {"type":"object","additionalProperties":false,"required":["catalog_id","entity_id","member_id"],"properties":{"catalog_id":{"$ref":"definitions.json#/$defs/catalog_id"},"entity_id":{"$ref":"definitions.json#/$defs/semantic_id"},"member_id":{"$ref":"definitions.json#/$defs/semantic_id"},"relationship_path":{"type":"array","items":{"$ref":"definitions.json#/$defs/semantic_id"}}}}
    ]},
    "filter":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["and"],"properties":{"and":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/filter"}}}},
      {"type":"object","additionalProperties":false,"required":["or"],"properties":{"or":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/filter"}}}},
      {"$ref":"#/$defs/filter_predicate"}
    ]},
    "filter_predicate":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["member","operator","value"],"properties":{"member":{"$ref":"#/$defs/filter_member"},"operator":{"enum":["eq","neq","gt","gte","lt","lte"]},"value":{}}},
      {"type":"object","additionalProperties":false,"required":["member","operator","values"],"properties":{"member":{"$ref":"#/$defs/filter_member"},"operator":{"enum":["in","not_in"]},"values":{"type":"array","minItems":1,"maxItems":100}}},
      {"type":"object","additionalProperties":false,"required":["member","operator","values"],"properties":{"member":{"$ref":"#/$defs/filter_member"},"operator":{"const":"between"},"values":{"type":"array","minItems":2,"maxItems":2}}},
      {"type":"object","additionalProperties":false,"required":["member","operator"],"properties":{"member":{"$ref":"#/$defs/filter_member"},"operator":{"enum":["is_null","is_not_null"]}}}
    ]}
  }
}
