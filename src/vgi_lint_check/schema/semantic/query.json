{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://query.farm/schema/vgi/semantic/query.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "measures": {"type":"array","maxItems":50,"items":{"$ref":"#/$defs/measure_selection"}},
    "dimensions": {"type":"array","maxItems":50,"items":{"$ref":"#/$defs/dimension_selection"}},
    "filters": {"$ref":"#/$defs/filter"},
    "measure_filters": {"$ref":"#/$defs/filter"},
    "order": {"type":"array","maxItems":50,"items":{"type":"object","additionalProperties":false,"required":["member","direction"],"properties":{"member":{"type":"string","minLength":1},"direction":{"enum":["asc","desc"]}}}},
    "limit": {"type":"integer","minimum":1,"maximum":10000,"default":1000},
    "compile_only": {"type":"boolean","default":false},
    "root_entity": {"$ref":"definitions.json#/$defs/entity_ref"},
    "bindings": {"type":"object","additionalProperties":{"type":"string","minLength":1}},
    "parameters": {"type":"object","additionalProperties":true},
    "inputs": {"type":"array","maxItems":10,"items":{"$ref":"#/$defs/input"}},
    "source_bindings": {"type":"array","maxItems":10,"items":{"$ref":"#/$defs/source_binding"}},
    "allow_driving_grain_reduction": {"type":"boolean","default":false},
    "execution_limits": {"type":"object","additionalProperties":false,"properties":{"max_invocations":{"type":"integer","minimum":1,"maximum":1000}}}
  },
  "anyOf": [{"required":["measures"]},{"required":["dimensions"]}],
  "$defs": {
    "member_ref": {"type":"object","additionalProperties":false,"required":["catalog_id","entity_id","member_id"],"properties":{"catalog_id":{"$ref":"definitions.json#/$defs/catalog_id"},"entity_id":{"$ref":"definitions.json#/$defs/semantic_id"},"member_id":{"$ref":"definitions.json#/$defs/semantic_id"}}},
    "measure_selection": {"type":"object","additionalProperties":false,"required":["catalog_id","entity_id","member_id"],"properties":{"catalog_id":{"$ref":"definitions.json#/$defs/catalog_id"},"entity_id":{"$ref":"definitions.json#/$defs/semantic_id"},"member_id":{"$ref":"definitions.json#/$defs/semantic_id"},"alias":{"type":"string","minLength":1}}},
    "dimension_selection": {"type":"object","additionalProperties":false,"required":["catalog_id","entity_id","member_id"],"properties":{"catalog_id":{"$ref":"definitions.json#/$defs/catalog_id"},"entity_id":{"$ref":"definitions.json#/$defs/semantic_id"},"member_id":{"$ref":"definitions.json#/$defs/semantic_id"},"relationship_path":{"type":"array","items":{"$ref":"definitions.json#/$defs/semantic_id"}},"granularity":{"enum":["minute","hour","day","week","month","quarter","year"]},"alias":{"type":"string","minLength":1}}},
    "input_column": {"type":"object","additionalProperties":false,"required":["name","type"],"properties":{"name":{"type":"string","minLength":1,"maxLength":200},"type":{"type":"string","minLength":1,"maxLength":100},"nullable":{"type":"boolean","default":false}}},
    "input": {"type":"object","additionalProperties":false,"required":["input_id","grain","columns","rows"],"properties":{"input_id":{"$ref":"definitions.json#/$defs/semantic_id"},"grain":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"columns":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/input_column"}},"rows":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"array","maxItems":32}}}},
    "source_argument_binding": {"oneOf":[
      {"type":"object","additionalProperties":false,"required":["parameter"],"properties":{"parameter":{"$ref":"definitions.json#/$defs/semantic_id"}}},
      {"type":"object","additionalProperties":false,"required":["input_column"],"properties":{"input_column":{"type":"string","minLength":1}}},
      {"type":"object","additionalProperties":false,"required":["member"],"properties":{"member":{"$ref":"#/$defs/member_ref"}}}
    ]},
    "driver": {"oneOf":[
      {"type":"object","additionalProperties":false,"required":["input_id"],"properties":{"input_id":{"$ref":"definitions.json#/$defs/semantic_id"}}},
      {"type":"object","additionalProperties":false,"required":["entity","max_rows"],"properties":{"entity":{"$ref":"definitions.json#/$defs/entity_ref"},"max_rows":{"type":"integer","minimum":1,"maximum":1000},"filters":{"$ref":"#/$defs/filter"},"order":{"type":"array","maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["member_id","direction"],"properties":{"member_id":{"$ref":"definitions.json#/$defs/semantic_id"},"direction":{"enum":["asc","desc"]}}}}}}
    ]},
    "source_binding": {"type":"object","additionalProperties":false,"required":["entity","driver","arguments"],"properties":{"entity":{"$ref":"definitions.json#/$defs/entity_ref"},"driver":{"$ref":"#/$defs/driver"},"arguments":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/source_argument_binding"}},"max_output_rows":{"type":"integer","minimum":1,"maximum":10000}}},
    "filter_member": {"oneOf":[{"type":"string","minLength":1},{"type":"object","additionalProperties":false,"required":["catalog_id","entity_id","member_id"],"properties":{"catalog_id":{"$ref":"definitions.json#/$defs/catalog_id"},"entity_id":{"$ref":"definitions.json#/$defs/semantic_id"},"member_id":{"$ref":"definitions.json#/$defs/semantic_id"},"relationship_path":{"type":"array","items":{"$ref":"definitions.json#/$defs/semantic_id"}}}}]},
    "filter": {"oneOf":[{"type":"object","additionalProperties":false,"required":["and"],"properties":{"and":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/filter"}}}},{"type":"object","additionalProperties":false,"required":["or"],"properties":{"or":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/filter"}}}},{"$ref":"#/$defs/filter_predicate"}]},
    "filter_predicate": {"oneOf":[{"type":"object","additionalProperties":false,"required":["member","operator","value"],"properties":{"member":{"$ref":"#/$defs/filter_member"},"operator":{"enum":["eq","neq","gt","gte","lt","lte"]},"value":{}}},{"type":"object","additionalProperties":false,"required":["member","operator","values"],"properties":{"member":{"$ref":"#/$defs/filter_member"},"operator":{"enum":["in","not_in"]},"values":{"type":"array","minItems":1,"maxItems":100}}},{"type":"object","additionalProperties":false,"required":["member","operator","values"],"properties":{"member":{"$ref":"#/$defs/filter_member"},"operator":{"const":"between"},"values":{"type":"array","minItems":2,"maxItems":2}}},{"type":"object","additionalProperties":false,"required":["member","operator"],"properties":{"member":{"$ref":"#/$defs/filter_member"},"operator":{"enum":["is_null","is_not_null"]}}}]}
  }
}
