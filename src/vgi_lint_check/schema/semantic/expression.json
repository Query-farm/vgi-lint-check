{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://query.farm/schema/vgi/semantic/expression.json",
  "$defs":{
    "expr":{
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["op","member"],"properties":{"op":{"const":"member"},"member":{"$ref":"definitions.json#/$defs/semantic_id"}}},
        {"type":"object","additionalProperties":false,"required":["op","value"],"properties":{"op":{"const":"literal"},"value":{"type":["string","number","boolean","null"]}}},
        {"type":"object","additionalProperties":false,"required":["op","left","right"],"properties":{"op":{"enum":["add","subtract","multiply","divide","safe_divide"]},"left":{"$ref":"#/$defs/expr"},"right":{"$ref":"#/$defs/expr"}}},
        {"type":"object","additionalProperties":false,"required":["op","args"],"properties":{"op":{"enum":["coalesce"]},"args":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/expr"}}}},
        {"type":"object","additionalProperties":false,"required":["op","value"],"properties":{"op":{"const":"nullif"},"value":{"$ref":"#/$defs/expr"},"other":{"$ref":"#/$defs/expr"}}},
        {"type":"object","additionalProperties":false,"required":["op","value","type"],"properties":{"op":{"const":"cast"},"value":{"$ref":"#/$defs/expr"},"type":{"type":"string","minLength":1,"maxLength":100}}},
        {"type":"object","additionalProperties":false,"required":["op","when","then"],"properties":{"op":{"const":"case"},"when":{"$ref":"#/$defs/expr"},"then":{"$ref":"#/$defs/expr"},"else":{"$ref":"#/$defs/expr"}}}
      ]
    }
  },
  "$ref":"#/$defs/expr"
}
