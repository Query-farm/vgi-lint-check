{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://query.farm/schema/vgi/semantic/member.json",
  "oneOf": [
    {"$ref": "#/$defs/identifier"},
    {"$ref": "#/$defs/dimension"},
    {"$ref": "#/$defs/time_dimension"},
    {"$ref": "#/$defs/measure"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["member_id", "kind"],
      "properties": {
        "member_id": {"$ref": "definitions.json#/$defs/semantic_id"},
        "kind": {"enum": ["identifier", "dimension", "time_dimension", "measure"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "data_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "output_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "conformance_id": {"$ref": "definitions.json#/$defs/semantic_id"},
        "hidden": {"type": "boolean"}
      }
    },
    "unit_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argument", "values"],
      "properties": {
        "argument": {"type": "string", "minLength": 1},
        "values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "identifier": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_id", "kind"],
          "not": {"required": ["column", "column_path"]},
          "properties": {
            "member_id": {"$ref": "definitions.json#/$defs/semantic_id"},
            "kind": {"const": "identifier"},
            "title": {"type": "string"},
            "description": {"type": "string"},
            "data_type": {"type": "string"},
            "output_type": {"type": "string"},
            "conformance_id": {"$ref": "definitions.json#/$defs/semantic_id"},
            "hidden": {"type": "boolean"},
            "column": {"type": "string", "minLength": 1},
            "column_path": {"$ref": "#/$defs/column_path"}
          }
        }
      ]
    },
    "dimension": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_id", "kind"],
          "not": {"anyOf": [{"required": ["unit", "unit_parameter"]}, {"required": ["column", "column_path"]}, {"required": ["source_argument", "column"]}, {"required": ["source_argument", "column_path"]}, {"required": ["source_argument", "expression"]}]},
          "properties": {
            "member_id": {"$ref": "definitions.json#/$defs/semantic_id"},
            "kind": {"const": "dimension"},
            "title": {"type": "string"},
            "description": {"type": "string"},
            "data_type": {"type": "string"},
            "output_type": {"type": "string"},
            "conformance_id": {"$ref": "definitions.json#/$defs/semantic_id"},
            "hidden": {"type": "boolean"},
            "column": {"type": "string", "minLength": 1},
            "column_path": {"$ref": "#/$defs/column_path"},
            "source_argument": {"type": "string", "minLength": 1},
            "expression": {"$ref": "expression.json"},
            "unit": {"type": "string", "minLength": 1},
            "unit_parameter": {"$ref": "#/$defs/unit_parameter"}
          }
        }
      ]
    },
    "time_dimension": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_id", "kind", "timezone", "granularities"],
          "not": {"anyOf": [{"required": ["unit", "unit_parameter"]}, {"required": ["column", "column_path"]}, {"required": ["source_argument", "column"]}, {"required": ["source_argument", "column_path"]}, {"required": ["source_argument", "expression"]}]},
          "properties": {
            "member_id": {"$ref": "definitions.json#/$defs/semantic_id"},
            "kind": {"const": "time_dimension"},
            "title": {"type": "string"},
            "description": {"type": "string"},
            "data_type": {"type": "string"},
            "output_type": {"type": "string"},
            "conformance_id": {"$ref": "definitions.json#/$defs/semantic_id"},
            "hidden": {"type": "boolean"},
            "column": {"type": "string", "minLength": 1},
            "column_path": {"$ref": "#/$defs/column_path"},
            "source_argument": {"type": "string", "minLength": 1},
            "expression": {"$ref": "expression.json"},
            "timezone": {"type": "string", "minLength": 1},
            "granularities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["minute", "hour", "day", "week", "month", "quarter", "year"]}
            },
            "week_start": {"const": "monday"},
            "unit": {"type": "string", "minLength": 1},
            "unit_parameter": {"$ref": "#/$defs/unit_parameter"}
          }
        }
      ]
    },
    "column_path": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "local_filter": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["and"],"properties":{"and":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/local_filter"}}}},
        {"type":"object","additionalProperties":false,"required":["or"],"properties":{"or":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/local_filter"}}}},
        {"$ref":"#/$defs/local_filter_predicate"}
      ]
    },
    "local_filter_predicate": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["member","operator","value"],"properties":{"member":{"$ref":"definitions.json#/$defs/semantic_id"},"operator":{"enum":["eq","neq","gt","gte","lt","lte"]},"value":{}}},
        {"type":"object","additionalProperties":false,"required":["member","operator","values"],"properties":{"member":{"$ref":"definitions.json#/$defs/semantic_id"},"operator":{"enum":["in","not_in"]},"values":{"type":"array","minItems":1,"maxItems":100}}},
        {"type":"object","additionalProperties":false,"required":["member","operator","values"],"properties":{"member":{"$ref":"definitions.json#/$defs/semantic_id"},"operator":{"const":"between"},"values":{"type":"array","minItems":2,"maxItems":2}}},
        {"type":"object","additionalProperties":false,"required":["member","operator"],"properties":{"member":{"$ref":"definitions.json#/$defs/semantic_id"},"operator":{"enum":["is_null","is_not_null"]}}}
      ]
    },
    "measure": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_id", "kind", "additivity"],
          "oneOf": [{"required": ["aggregation"]}, {"required": ["expression"]}],
          "not": {"required": ["unit", "unit_parameter"]},
          "properties": {
            "member_id": {"$ref": "definitions.json#/$defs/semantic_id"},
            "kind": {"const": "measure"},
            "title": {"type": "string"},
            "description": {"type": "string"},
            "data_type": {"type": "string"},
            "output_type": {"type": "string"},
            "hidden": {"type": "boolean"},
            "aggregation": {"enum": ["count_rows", "count", "count_distinct", "sum", "min", "max", "avg"]},
            "member": {"$ref": "definitions.json#/$defs/semantic_id"},
            "expression": {"$ref": "expression.json"},
            "additivity": {"$ref": "definitions.json#/$defs/additivity"},
            "unit": {"type": "string", "minLength": 1},
            "unit_parameter": {"$ref": "#/$defs/unit_parameter"},
            "filter": {"$ref": "#/$defs/local_filter"}
          }
        }
      ]
    }
  }
}
